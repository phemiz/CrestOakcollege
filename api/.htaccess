## Block direct access to any JSON files in the API directory
<FilesMatch "\.json$">
    Require all denied
</FilesMatch>

## Block direct access to the config file (contains DB credentials)
<FilesMatch "^config\.php$">
    Require all denied
</FilesMatch>

# Ensure cookies are sent only over HTTPS (if using HTTPS)
Header always edit Set-Cookie ^(.*)$ $1;Secure;HttpOnly;SameSite=Lax
