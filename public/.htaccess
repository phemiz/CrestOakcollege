# --- CrestOak College Subdomain Gateway Routing ---
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 2. Allow existing files and directories to load directly (CSS, JS, Images, API)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Handle Static Route Folders (e.g., /login -> /login/index.html)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ /$1/index.html [L]

  # 4. Fallback for Single Page App routing
  RewriteRule ^ index.html [L]
</IfModule>

# --- Performance & MIME Types ---
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
</IfModule>

