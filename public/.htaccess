Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. If file or directory exists directly, serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Map clean URL (e.g., /academics) to /academics/index.html
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)$ /$1/index.html [QSA,L]

# 3. Map clean URL (e.g., /academics) to /academics.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ /$1.html [QSA,L]

# 4. Fallback to main index.html or 404
ErrorDocument 404 /404.html
