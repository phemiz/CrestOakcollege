RewriteEngine On
RewriteBase /

# 1. Auto-redirect directories without trailing slashes to include trailing slash (preserves query params like ?faculty=health)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ $1/ [R=301,L,QSA]

# 2. Serve subfolder/index.html for directory paths
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ %{REQUEST_FILENAME}/index.html [L,QSA]

# 3. Fallback for clean .html files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L,QSA]

# 4. Custom 404 page
ErrorDocument 404 /404.html
