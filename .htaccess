Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. If a matching .html file exists at root (e.g., contact.html), serve it for both /contact and /contact/
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)/?$ /$1.html [QSA,L]

# 2. Map directory requests to their index.html file if index.html actually exists
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ /$1/index.html [QSA,L]

# 3. If file or directory exists directly, serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4. Fallback to 404
ErrorDocument 404 /404.html
