DirectoryIndex index.html index.php

<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/css .css
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Serve existing files directly (images, js, css, php, _next assets)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Serve index.html for directory requests (e.g. /login/, /admin/dashboard/)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 3. Serve index.html for paths matching folder names (e.g. /login -> /login/index.html)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 4. Try adding .html extension if file exists
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 5. Fallback to 404.html if file or directory does not exist
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/404.html -f
  RewriteRule ^ 404.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Never cache HTML files or JSON endpoints
  <FilesMatch "\.(html|htm|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache static JS/CSS chunks with revalidation
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css|css|png|jpg|jpeg|svg|webp|ico)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>
