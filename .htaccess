<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow existing files or directories to be served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Subdomain specific rewrites (when subdomains share the main document root)
  RewriteCond %{HTTP_HOST} ^admin\.crestoakcollege\.com\.ng$ [NC]
  RewriteCond %{REQUEST_URI} ^/$
  RewriteRule ^$ /login/?gateway=admin [L,R=302]

  RewriteCond %{HTTP_HOST} ^staff\.crestoakcollege\.com\.ng$ [NC]
  RewriteCond %{REQUEST_URI} ^/$
  RewriteRule ^$ /login/?gateway=staff [L,R=302]

  RewriteCond %{HTTP_HOST} ^portal\.crestoakcollege\.com\.ng$ [NC]
  RewriteCond %{REQUEST_URI} ^/$
  RewriteRule ^$ /login/?gateway=portal [L,R=302]

  RewriteCond %{HTTP_HOST} ^pay\.crestoakcollege\.com\.ng$ [NC]
  RewriteCond %{REQUEST_URI} ^/$
  RewriteRule ^$ /login/?gateway=pay [L,R=302]

  RewriteCond %{HTTP_HOST} ^admissions\.crestoakcollege\.com\.ng$ [NC]
  RewriteCond %{REQUEST_URI} ^/$
  RewriteRule ^$ /admissions [L,R=302]

  RewriteCond %{HTTP_HOST} ^register\.crestoakcollege\.com\.ng$ [NC]
  RewriteCond %{REQUEST_URI} ^/$
  RewriteRule ^$ /admissions/register [L,R=302]

  # 3. Next.js Static Export Route Resolution (.html extension or directory index.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # Never cache HTML files or JSON endpoints
    <FilesMatch "\.(html|htm|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # Cache static JS/CSS chunks with revalidation
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "max-age=0, must-revalidate"
    </FilesMatch>

    <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css|css|png|jpg|jpeg|svg|webp|ico)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>
